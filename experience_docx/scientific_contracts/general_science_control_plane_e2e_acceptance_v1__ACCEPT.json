{
  "competing_explanation": "A route-specific shortcut could appear successful without exercising the generic lifecycle and archive boundaries.",
  "controls": [
    "generic runner identity",
    "write-once completion ledger"
  ],
  "decision_table": {
    "rules": [
      {
        "id": "integrity_veto",
        "terminal": "inconclusive",
        "when": {
          "integrity": [
            "fail",
            "invalid"
          ]
        }
      },
      {
        "id": "unsafe_lifecycle_fails",
        "terminal": "fail",
        "when": {
          "integrity": [
            "pass"
          ],
          "lifecycle_safety": [
            "unsafe"
          ]
        }
      },
      {
        "id": "safe_lifecycle_passes",
        "terminal": "pass",
        "when": {
          "integrity": [
            "pass"
          ],
          "lifecycle_safety": [
            "safe"
          ]
        }
      },
      {
        "id": "unresolved_lifecycle_is_inconclusive",
        "terminal": "inconclusive",
        "when": {
          "integrity": [
            "pass"
          ],
          "lifecycle_safety": [
            "indeterminate",
            "invalid"
          ]
        }
      }
    ],
    "terminal_actions": {
      "fail": {
        "family_effect": "stop",
        "next_action_id": "stop_control_plane_acceptance",
        "terminal": {
          "authorizes": "NONE",
          "decision": "CONTROL_PLANE_E2E_ACCEPTANCE_FAIL",
          "state": "COMPLETED_GATE_FAIL"
        }
      },
      "inconclusive": {
        "family_effect": "allow_predeclared_evidence",
        "next_action_id": "inspect_control_plane_acceptance",
        "terminal": {
          "authorizes": "NONE",
          "decision": "CONTROL_PLANE_E2E_ACCEPTANCE_INCONCLUSIVE",
          "state": "COMPLETED_INCONCLUSIVE"
        }
      },
      "pass": {
        "family_effect": "advance",
        "next_action_id": "archive_control_plane_acceptance",
        "terminal": {
          "authorizes": "ARCHIVE_ONLY",
          "decision": "CONTROL_PLANE_E2E_ACCEPTANCE_PASS",
          "state": "COMPLETED_GATE_PASS"
        }
      }
    }
  },
  "disabled_actions": [
    "dataset access",
    "checkpoint access",
    "model execution",
    "scientific performance claim"
  ],
