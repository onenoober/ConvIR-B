{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "rules_commit",
    "repository_linux_path",
    "task_class",
    "source_identity",
    "source_role",
    "source_effort",
    "required_role",
    "dispatch_reason",
    "routing_basis",
    "routing_basis_ref",
    "effort",
    "execution_scope",
    "transport_contract",
    "completion_marker",
    "route_branch_commit",
    "route_id",
    "stage_state",
    "decision",
    "authorizes",
    "cloud_status",
    "next_action",
    "authorization_check"
  ],
  "properties": {
    "schema_version": {"const": 2},
    "rules_commit": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "repository_linux_path": {"type": "string", "pattern": "^/"},
    "task_class": {
      "enum": ["R0_READ_ONLY", "R1_BOUNDED_EXECUTION", "R2_ENGINEERING_CONTROL", "R3_SCIENTIFIC_AUTHORITY"]
    },
    "source_identity": {
      "enum": ["unknown", "user_pinned_task", "product_metadata", "cli_status", "dispatcher_receipt"]
    },
    "source_role": {"enum": ["unknown", "fast", "balanced", "frontier"]},
    "source_effort": {"enum": ["unknown", "low", "medium", "high", "xhigh"]},
    "required_role": {"enum": ["fast", "balanced", "frontier"]},
    "dispatch_reason": {
      "enum": ["task_routing", "standalone_repetition", "batch_bounded_operations", "major_handoff"]
    },
    "routing_basis": {"enum": ["dispatcher_classification", "typed_handoff"]},
    "routing_basis_ref": {
      "type": "string",
      "pattern": "^(none|github:[0-9a-f]{40}:[A-Za-z0-9._/-]+)$",
      "maxLength": 1000
    },
    "effort": {"enum": ["low", "medium", "high"]},
    "execution_scope": {
      "enum": ["local_read_only", "local_workspace_write", "wsl_workspace_transport", "wsl_cloud_transport"]
    },
    "transport_contract": {
      "enum": ["local_only", "tracked_convir_cloud"]
    },
    "completion_marker": {
      "type": "string",
      "pattern": "^[A-Z][A-Z0-9_]{2,127}$"
    },
    "route_branch_commit": {
      "type": "string",
      "pattern": "^(none|[0-9a-f]{40})$"
    },
    "route_id": {"type": "string", "minLength": 1},
    "stage_state": {"type": "string", "minLength": 1},
    "decision": {"type": "string", "minLength": 1},
    "authorizes": {"type": "string", "minLength": 1},
    "cloud_status": {"type": "string", "minLength": 1},
    "next_action": {"type": "string", "minLength": 1, "maxLength": 2000},
    "authorization_check": {
      "type": "object",
      "additionalProperties": false,
      "required": ["verified", "mechanism", "checked_fields"],
      "properties": {
        "verified": {"type": "boolean"},
        "mechanism": {
          "enum": ["not_applicable", "runner_exact_tuple", "balanced_closeout_audit"]
        },
        "checked_fields": {
          "type": "array",
          "items": {"enum": ["route_id", "state", "decision", "authorizes"]},
          "uniqueItems": true
        }
      }
    }
  }
}
