            "reference": "OOF utility LCB above 0.05 dB, material-scene Wilson LCB above 0.20, both spatial-control LCBs above zero, and frozen test-development point gain at least 0.025 dB",
            "direction": "min",
            "threshold": "oof_gain_lcb_gt_0.05_and_prevalence_lcb_gt_0.20_and_uniform_lcb_gt_0_and_shuffle_lcb_gt_0_and_test_point_ge_0.025",
            "uncertainty_id": "scene_level_familywise_uncertainty",
