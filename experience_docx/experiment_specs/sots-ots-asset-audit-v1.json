      "scientific_contract": {
        "question": "Do the exact cloud assets provide one hashable ots-base.pkl file and a complete SOTS-Outdoor copy with 500 hazy images paired to 492 unique clear-source groups?",
        "population": {
          "evidence_role": "engineering_debug",
          "grouping_unit": "asset_file_and_source_group",
          "independent_group_count": 492,
          "allow_confirmation": false,
          "allow_canary": false,
          "allow_locked_test": false
        },
        "intervention": {
          "primary_variable": "asset_identity_and_pairing_integrity",
          "reference": "the user-provided fixed checkpoint and finalized RESIDE SOTS-Outdoor directory layout",
          "matched_budget": "one complete deterministic metadata and SHA-256 census with zero model execution",
          "fixed_factors": [
            "checkpoint path is /sda/home/wangyuxin/ConvIR-B/checkpoints/official/ots-base.pkl",
            "SOTS root is /sda/home/wangyuxin/ConvIR-B/datasets/RESIDE/official/SOTS/outdoor",
            "only supported image files directly below gt and hazy are counted",
            "a hazy filename maps to the GT stem before its first underscore",
            "the aggregate dataset digest binds ordered relative path, byte size and file SHA-256",
            "no image-derived metric, model load, inference, training or protected evidence access is allowed"
          ]
        },
        "primary_estimand": {
          "id": "asset_qualification_pass",
          "metric": "binary conjunction of checkpoint identity availability, exact file counts, complete source pairing and deterministic aggregate digest",
          "direction": "higher",
          "aggregation": "all required integrity checks must pass",
          "unit": "asset_contract"
        },
        "controls": [
          "all file identities use SHA-256",
          "unsupported non-image files are excluded from image counts but reported",
          "every GT source must be referenced and every hazy image must resolve to exactly one GT source",
          "only aggregate counts and digests are published; no image content or per-file table is archived"
        ],
        "uncertainty": {
          "method": "deterministic complete asset census",
          "confidence_level": 0.95,
          "independent_unit": "asset_file_and_source_group"
        },
        "gates": [
          {
            "id": "checkpoint_identity",
            "type": "integrity",
            "estimand": "ots-base.pkl exists, is nonempty and has a 64-hex SHA-256 identity",
            "direction": "equal",
            "threshold": 1.0,
            "decision_role": "decisive"
          },
          {
            "id": "sots_counts",
            "type": "integrity",
            "estimand": "direct image counts in SOTS-Outdoor gt and hazy",
            "direction": "equal",
            "threshold": 1.0,
            "decision_role": "decisive"
          },
          {
            "id": "source_pairing",
            "type": "integrity",
            "estimand": "500 hazy images map completely to exactly 492 unique GT source groups and all GT sources are used",
            "direction": "equal",
            "threshold": 1.0,
            "decision_role": "decisive"
          },
          {
            "id": "aggregate_digest",
            "type": "integrity",
            "estimand": "ordered file identity census produces one deterministic 64-hex aggregate SHA-256",
            "direction": "equal",
            "threshold": 1.0,
            "decision_role": "decisive"
          }
        ],
        "competing_explanation": "Correct counts alone could hide a changed data copy, which is why the aggregate digest includes every ordered file path, size and content SHA-256. This audit cannot establish model quality, generalization or scientific validity.",
        "terminal_mapping": {
          "pass": {
            "state": "COMPLETED_GATE_PASS",
            "decision": "SOTS_OTS_ASSET_AUDIT_PASS",
            "authorizes": "SOTS_OTS_LOCAL_ERROR_MEASUREMENT_CONTRACT"
