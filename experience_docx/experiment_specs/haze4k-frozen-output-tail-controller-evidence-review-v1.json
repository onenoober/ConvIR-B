          {
            "id": "coverage",
            "type": "coverage",
            "estimand_id": "scene_reconstruction_mismatch_prevalence",
            "reference": "exact 600-scene by 9-cell utility/risk census, five folds, 600 selected-action replays, and one cloud diagnostic per scene",
            "direction": "equal",
            "threshold": true,
            "uncertainty_id": "scene_mismatch_prevalence_uncertainty",
            "comparison_family": "utility_risk_reconstruction_identity",
            "decision_role": "validity_veto",
            "outcomes": ["pass", "fail", "invalid"],
            "neutral_outcome": "pass"
          },
          {
            "id": "reconstruction_materiality",
            "type": "materiality",
            "estimand_id": "scene_reconstruction_mismatch_prevalence",
            "reference": "favorable requires max in (1e-6,1e-5], saved-seed consistency <=1e-6, finite float32 shape identity, and zero selected-action or terminal-gate changes; unfavorable requires max >1e-4, nonfinite/shape/dtype failure, saved-seed inconsistency >1e-6, or any selected-action change; all other values are indeterminate",
            "direction": "max",
            "threshold": "bounded_decision_invariant_discrepancy_classification",
            "uncertainty_id": "scene_mismatch_prevalence_uncertainty",
            "comparison_family": "utility_risk_reconstruction_identity",
            "decision_role": "decisive",
            "outcomes": ["favorable", "unfavorable", "indeterminate", "invalid"],
            "neutral_outcome": "favorable"
          },
          {
            "id": "precision",
            "type": "precision",
            "estimand_id": "scene_reconstruction_mismatch_prevalence",
            "reference": "maximum Wilson distance for scene mismatch prevalence under the frozen two-channel critical value",
            "direction": "max",
            "threshold": 0.05,
            "uncertainty_id": "scene_mismatch_prevalence_uncertainty",
            "comparison_family": "utility_risk_reconstruction_identity",
            "decision_role": "inconclusive_only",
            "outcomes": ["met", "unmet", "invalid"],
            "neutral_outcome": "met"
          }
        ],
        "competing_explanation": "The original failure may be a bounded CUDA repeatability effect, an intermediate unexplained discrepancy, a material asset or dtype mismatch, or a one-off event that cannot be reproduced from the saved arrays; action replay separates numerical difference from decision impact.",
