      "scientific_contract": {
        "question": "Is the parent raw-prediction reconstruction failure a bounded decision-invariant numerical discrepancy rather than a material saved-prediction identity failure?",
        "population": {
          "evidence_role": "development_screening",
          "grouping_unit": "original_clear_scene",
          "independent_group_count": 600,
          "strata": [
            {
              "id": "haze4k_train_oof",
              "independent_group_count": 600
            }
          ],
          "allow_confirmation": false,
          "allow_canary": false,
          "allow_locked_test": false
        },
        "intervention": {
          "primary_variable": "absolute difference between each saved qualification ensemble utility/risk array and its receipt-bound upstream factorial ensemble array",
          "reference": "the upstream saved float32 ensemble utility/risk arrays that were the parent qualification reconstruction target",
          "matched_budget": "all 600 OOF original-clear scenes, all nine cells, both utility and risk channels, and the exact corresponding fold-specific three-checkpoint identities",
          "fixed_factors": [
            "the parent receipt, route commit, selection freeze SHA, selected R0_L1 weighted-q/raw/setwise/cap-0.01 candidate, thresholds, gates, and data roles remain frozen",
            "both cloud raw workspaces are fully rehashed against their archived inventories before comparison",
            "comparison is at the saved ensemble level because upstream raw files do not contain single-seed predictions",
            "current saved ensembles are separately compared with the mean of their three saved seed arrays",
            "all differences are computed on CPU by NumPy float64 subtraction from saved float32 arrays; their production source is CUDA sm89",
            "the frozen selected action map is replayed from current and upstream R0_L1 raw utility and weighted-q risk using the upstream frozen scene-cache tile areas",
            "the candidate selection is not rerun and calibration predictions are not read; the parent selection freeze predates its formal OOF array parse",
            "original-clear scenes are the only independent units; cells, files, tiles, actions, and elements never increase n",
            "confirmation, canary, locked-test, NH-Haze, ITS, OTS, images, targets, model inference, and training remain out of scope"
          ]
        },
        "primary_estimand": {
          "id": "scene_reconstruction_mismatch_prevalence",
          "metric_id": "scene_any_utility_or_risk_absolute_error_gt_1e_6",
          "direction": "lower",
          "aggregation": "prevalence over 600 original-clear scenes where any saved ensemble element across nine cells and two metrics strictly exceeds 1e-6",
          "unit": "original_clear_scene",
          "strata": ["haze4k_train_oof"]
        },
        "controls": [
          "GitHub-main parent closeout, conclusion, summary, gate summary, selection freeze, raw inventory and inventory verification identities",
          "complete current 745-file and upstream 10285-file cloud inventory rehash",
          "saved current ensemble versus saved three-seed mean consistency for utility and risk",
          "strict exceedance counts at 1e-6, 1e-5 and 1e-4 by element, cell, scene and file",
          "finite-element p50, p90, p95, p99, p99.9 and maximum errors separately for utility and risk",
          "maximizing cell, fold, hashed scene, action, row, column, dtype, current/upstream file SHA and three checkpoint SHAs",
          "current-versus-saved, upstream-versus-saved and current-versus-upstream selected-action replay",
          "weighted-q selected-area risk and raw-utility difference checks",
          "cloud-only per-scene by-cell diagnostics and compact raw diagnostic inventory"
        ],
        "uncertainty": {
          "id": "scene_mismatch_prevalence_uncertainty",
          "method_id": "bonferroni_wilson_scene_prevalence_with_finite_population_array_census",
          "confidence_level": 0.95,
          "independent_unit": "original_clear_scene",
          "comparison_family": "utility_risk_reconstruction_identity"
        },
        "gates": [
          {
            "id": "evidence_identity",
            "type": "integrity",
            "estimand_id": "scene_reconstruction_mismatch_prevalence",
            "reference": "all parent compact artifacts and both receipt-bound raw workspace inventories match their frozen identities",
            "direction": "equal",
            "threshold": true,
            "uncertainty_id": "scene_mismatch_prevalence_uncertainty",
            "comparison_family": "utility_risk_reconstruction_identity",
            "decision_role": "validity_veto",
            "outcomes": ["pass", "fail", "invalid"],
            "neutral_outcome": "pass"
