          "reference": "the 458 previously verified strict Haze4K-OTS source groups and 492 exact SOTS-outdoor-to-OTS source groups",
          "matched_budget": "all 1,000 canonical Haze4K clear groups, 8,970 OTS clear scenes, fixed seven views, top-64 retrieval, and no adaptive threshold change",
          "fixed_factors": [
            "64x64 RGB canonical digest",
            "dHash Hamming threshold 2",
            "pHash Hamming threshold 6",
            "strict grayscale correlation threshold 0.995",
            "strict RGB-mean difference threshold 0.04",
            "seven fixed full and crop views",
            "symmetric multi-view pHash top-64 retrieval",
            "maximum multi-view normalized grayscale correlation",
            "unresolved correlation floor 0.98",
            "best-versus-second score gap 0.005",
            "one-to-one mutual nearest-neighbour requirement"
